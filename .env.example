# Salin ke .env (lokal) atau D:\.server\kuliah\d4\devsecops\uts\.env (server).
# JANGAN commit .env.

NODE_ENV=development
PORT=3008
APP_URL=http://localhost:3008
CORS_ORIGINS=http://localhost:5173

# ── Rahasia ──────────────────────────────────────────────────────────────────
# Pakai user DB khusus aplikasi dengan hak minimal, bukan root:
#   CREATE USER 'classicmodels_app'@'localhost' IDENTIFIED BY '...';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON classicmodels.* TO 'classicmodels_app'@'localhost';
# Perintah migrasi (db:migrate, db:deploy, migrate resolve) butuh hak DDL:
# jalankan dengan DATABASE_URL user lain (mis. root) di depan perintahnya.
# Di server (container), host DB = host.docker.internal.
DATABASE_URL=mysql://classicmodels_app:ganti-password@localhost:3306/classicmodels
# Minimal 32 karakter acak, mis.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Opsional tapi disarankan — secret terpisah untuk refresh token.
JWT_REFRESH_SECRET=

# ── Opsional ─────────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=86400
JWT_REFRESH_EXPIRES_IN=604800
# Jumlah hop reverse proxy tepercaya (kosong = tidak di belakang proxy).
TRUST_PROXY=
# "true" kalau semua akses lewat Cloudflare (IP client dari CF-Connecting-IP).
BEHIND_CLOUDFLARE=

# ── Seed (npm run db:seed) ───────────────────────────────────────────────────
# Akun admin pertama. Hapus dari .env setelah dipakai.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
