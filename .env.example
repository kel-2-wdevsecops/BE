# Salin ke .env (lokal) atau D:\.server\kuliah\d4\devsecops\uts\.env (server).
# JANGAN commit .env.

NODE_ENV=development
PORT=3008
APP_URL=http://localhost:3008
CORS_ORIGINS=http://localhost:5173

# ── Rahasia ──────────────────────────────────────────────────────────────────
# API ini hanya membaca data, jadi user DB-nya cukup (dan sebaiknya hanya)
# punya hak SELECT. Kalaupun ada celah SQL injection, data tidak bisa diubah:
#   CREATE USER 'classicmodels_app'@'localhost' IDENTIFIED BY '...';
#   GRANT SELECT ON classicmodels.* TO 'classicmodels_app'@'localhost';
# Perintah Prisma yang mengubah skema (db:migrate, db:deploy, migrate
# resolve) butuh user lain ber-hak DDL (mis. root) di depan perintahnya.
# Di server (container), host DB = host.docker.internal.
DATABASE_URL=mysql://classicmodels_app:ganti-password@localhost:3306/classicmodels

# ── Opsional ─────────────────────────────────────────────────────────────────
# Jumlah hop reverse proxy tepercaya (kosong = tidak di belakang proxy).
TRUST_PROXY=
# "true" kalau semua akses lewat Cloudflare (IP client dari CF-Connecting-IP).
BEHIND_CLOUDFLARE=
